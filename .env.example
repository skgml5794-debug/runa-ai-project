# 이 파일을 복사해 `.env.local`을 만들고 값을 채우세요. (.env.local은 git에 올라가지 않습니다)

# 서버에서만 사용합니다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
ANTHROPIC_API_KEY=

# 선택: 기본값은 claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5

# 선택: Mixpanel 프로젝트 토큰(Project Settings의 Project Token). 비워 두면 추적하지 않습니다.
# NEXT_PUBLIC_ 값은 빌드할 때 들어가므로 바꾸면 다시 배포해야 합니다.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# mock(기본) 또는 claude. claude로 바꾸면 실제 API 호출과 비용이 발생합니다.
NEXT_PUBLIC_SUMMARIZER_MODE=mock
